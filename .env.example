# Social Worker environment overrides
#
# Everything here is optional: config/settings.yaml is the primary source of
# configuration. These variables are handy for CI or for keeping credentials
# out of the YAML files.

# --- target -----------------------------------------------------------------
SOCIAL_WORKER_TARGET_URL=http://127.0.0.1:8099
SOCIAL_WORKER_ENVIRONMENT=local

# Set only when you own the target or hold written permission to load test it.
SOCIAL_WORKER_AUTHORIZED=false
SOCIAL_WORKER_AUTHORIZATION_REFERENCE=
SOCIAL_WORKER_OPERATOR_CONTACT=

# --- database ---------------------------------------------------------------
# SQLite (default, development)
DATABASE_URL=sqlite:///data/social_worker.db
# PostgreSQL (production) - referenced from settings.yaml as ${DATABASE_URL}
# DATABASE_URL=postgresql+psycopg://social_worker:CHANGE_ME@localhost:5432/social_worker

# --- distributed controller (optional) --------------------------------------
REDIS_URL=
CONTROLLER_HOST=127.0.0.1
CONTROLLER_PORT=8800
# Shared secret for the controller API. Keep it out of version control; it is
# never written to logs or to a test-run configuration snapshot.
CONTROLLER_API_TOKEN=

# --- browser ----------------------------------------------------------------
PLAYWRIGHT_BROWSERS_PATH=
SOCIAL_WORKER_HEADLESS=true
